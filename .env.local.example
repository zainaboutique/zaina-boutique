# Site URL — used for metadata, sitemap.xml, and canonical links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console verification code (optional) — after adding your site
# in Search Console, choose the "HTML tag" verification method, and copy just
# the "content" value from the meta tag it shows you (not the whole tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 Measurement ID (optional) — Google Analytics > Admin >
# Data Streams > your web stream. Looks like "G-XXXXXXXXXX". Leave blank to
# skip analytics entirely — nothing is added to the page until this is set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Firebase project config — get these from Firebase Console > Project Settings > General.
# Leave these unset to run the app in demo mode (in-memory data, no persistence).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Razorpay — server-only keys, never prefix these with NEXT_PUBLIC_.
# Get test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
